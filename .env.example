# Local development. Copy to .env (never commit .env). Works as-is for SQLite.
ENVIRONMENT=development
DATABASE_URL=sqlite:///wastemaster.db
SECRET_KEY=local-dev-only-not-a-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=local-admin-pass-1
ANTHROPIC_API_KEY=
COOKIE_SECURE=0
# One-off: set ADMIN_RESET_PASSWORD=1 for a single start to set ADMIN_PASSWORD on an EXISTING admin, then remove it.
# ADMIN_RESET_PASSWORD=
# Production (Render): ENVIRONMENT=production, a PostgreSQL DATABASE_URL, a random 32+ char SECRET_KEY. See README.
